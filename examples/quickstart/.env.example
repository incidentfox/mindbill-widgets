# One developer-workspace sandbox key. No organization ID is required.
MINDBILL_API_KEY=mbp_sandbox_replace_with_your_key

# Local host application authentication; generate your own random values.
APP_ORIGIN=http://localhost:3001
STARTER_PASSWORD=replace_with_a_random_password_of_at_least_16_characters
APP_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
