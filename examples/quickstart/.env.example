# No environment file is needed for the default offline demo.
MINDBILL_MODE=demo

# To connect the SAME React components to your MindBill SANDBOX:
# MINDBILL_MODE=sandbox
# MINDBILL_API_KEY=replace_with_your_sandbox_key
# MINDBILL_ORG_ID=replace_with_your_sandbox_organization_id
# APP_ORIGIN=http://localhost:3001
# STARTER_PASSWORD=replace_with_a_random_password_of_at_least_16_characters
# APP_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
