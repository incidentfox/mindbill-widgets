{
  "name": "mindbill-widgets",
  "version": "0.0.0",
  "private": true,
  "description": "Public SDKs and embeddable widgets for the MindBill Partner API",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @mindbill/browser build && pnpm -r --filter '!@mindbill/browser' build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r clean",
    "lint": "eslint .",
    "pack:check": "pnpm build && node scripts/pack-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@angular/common": "^21.2.4",
    "@angular/compiler-cli": "^21.2.4",
    "@angular/core": "^21.2.4",
    "@angular/forms": "^21.2.4",
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.10",
    "eslint": "^10.9.1",
    "globals": "^16.3.0",
    "happy-dom": "^18.0.1",
    "ng-packagr": "^21.2.1",
    "react": "^19.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
