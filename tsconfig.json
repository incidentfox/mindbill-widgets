{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mindbill/browser": ["packages/browser/src/index.ts"],
      "@mindbill/embed": ["packages/embed/src/index.ts"],
      "@mindbill/node": ["packages/node/src/index.ts"],
      "@mindbill/react": ["packages/react/src/index.tsx"],
      "@mindbill/angular": ["packages/angular/src/public-api.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts"],
  "exclude": ["node_modules", "packages/*/dist"]
}
